<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>monthwise-api</UserSecretsId>
    <!-- Write the OpenAPI document on build; the front-end generates its API client from it. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name monthwise</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monthwise.Application\Monthwise.Application.csproj" />
    <!-- Infrastructure is referenced only for DI registration in Program.cs. -->
    <ProjectReference Include="..\Monthwise.Infrastructure\Monthwise.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!--
    Release build: `dotnet publish -p:FrontendDist=<path to frontend/dist>` copies the built
    front-end into wwwroot, so the API serves it (ADR 0006).
  -->
  <Target Name="PublishFrontend" AfterTargets="Publish" Condition="'$(FrontendDist)' != ''">
    <Error Condition="!Exists('$(FrontendDist)/index.html')" Text="FrontendDist '$(FrontendDist)' has no index.html; run 'npm run build' in frontend first." />
    <ItemGroup>
      <FrontendFile Include="$(FrontendDist)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFile)" DestinationFiles="@(FrontendFile->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Monthwise.Api.Tests" />
  </ItemGroup>

</Project>
