    "/api/banks": {
      "get": {
        "tags": [
          "Cards"
        ],
        "operationId": "GetBanks",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CardListEntryResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
