  "components": {
    "schemas": {
      "CardListEntryRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CardListEntryResponse": {
        "required": [
          "id",
          "name",
          "isPredefined"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "isPredefined": {
            "type": "boolean"
          }
        }
      },
      "CardListFilter": {
        "enum": [
          "Default",
          "Expired",
          "Archived",
          null
        ]
      },
      "CardReference": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CardRequest": {
        "required": [
          "name",
          "issuerId",
          "bankId",
          "cardNumber",
          "iban",
          "validFrom",
          "validThrough",
          "type",
          "isPrimary",
          "debtLimitCents",
          "allowsInstallments"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "issuerId": {
            "type": "string",
            "format": "uuid"
          },
          "bankId": {
            "type": "string",
            "format": "uuid"
          },
          "cardNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "iban": {
            "type": [
              "null",
              "string"
            ]
          },
          "validFrom": {
            "type": [
              "null",
              "string"
            ]
          },
          "validThrough": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/CardType"
          },
          "isPrimary": {
            "type": "boolean"
          },
          "debtLimitCents": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "allowsInstallments": {
            "type": "boolean"
          }
        }
      },
      "CardResponse": {
        "required": [
          "id",
          "name",
          "issuer",
          "bank",
          "cardNumberMasked",
          "ibanMasked",
          "validFrom",
          "validThrough",
          "type",
          "isPrimary",
          "debtLimitCents",
          "allowsInstallments",
          "status",
          "canBeUsed",
          "blockedOn",
          "blockReason",
          "expiredOn",
          "expiryReason",
          "archivedOn",
          "replacedBy",
          "replaces"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "issuer": {
            "$ref": "#/components/schemas/CardListEntryResponse"
          },
          "bank": {
            "$ref": "#/components/schemas/CardListEntryResponse"
          },
          "cardNumberMasked": {
            "type": [
              "null",
              "string"
            ]
          },
          "ibanMasked": {
            "type": [
              "null",
              "string"
            ]
          },
          "validFrom": {
            "type": [
              "null",
              "string"
            ]
          },
          "validThrough": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/CardType"
          },
          "isPrimary": {
            "type": "boolean"
          },
          "debtLimitCents": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "allowsInstallments": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/CardStatus"
          },
          "canBeUsed": {
            "type": "boolean"
          },
          "blockedOn": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "blockReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiredOn": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "expiryReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "archivedOn": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "replacedBy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CardReference"
              }
            ]
          },
          "replaces": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CardReference"
              }
            ]
          }
        }
      },
      "CardStateRequest": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CardStatus": {
        "enum": [
          "Archived",
          "Blocked",
          "Expired",
          "NotYetValid",
          "ExpiringSoon",
          "Active"
        ]
      },
      "CardType": {
        "enum": [
          "Debit",
          "Charge",
          "Credit",
          "Prepaid"
        ]
      },
      "DashboardCardsResponse": {
        "required": [
          "hasAnyCards",
          "cards"
        ],
        "type": "object",
        "properties": {
          "hasAnyCards": {
            "type": "boolean"
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardResponse"
            }
          }
        }
      },
      "ExpireCardRequest": {
        "required": [
          "reason",
          "replacementCardId"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "replacementCardId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status",
          "database"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatusValue"
          },
          "database": {
            "$ref": "#/components/schemas/HealthStatusValue"
          }
        }
      },
      "HealthStatusValue": {
        "enum": [
          "Healthy",
          "Degraded",
          "Unhealthy"
        ]
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
